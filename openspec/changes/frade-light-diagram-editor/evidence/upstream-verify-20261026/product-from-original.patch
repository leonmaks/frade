+                      })
+                    setReconnect(undefined)
+                  }}
+                >
+                  Изменить конец и исключить потоки
+                </button>
+                <button onClick={() => setReconnect(undefined)}>Отмена</button>
+              </div>
+            )}
+          </div>
+        </>,
+        container,
+      )}
+    </>
+  )
