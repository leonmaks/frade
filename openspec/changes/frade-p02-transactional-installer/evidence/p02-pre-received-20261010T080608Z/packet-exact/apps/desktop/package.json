{
  "name": "@frade/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "pnpm build:utility && electron-vite dev",
    "start": "electron .",
    "build": "node ../../scripts/check-drawio-assets.mjs && pnpm typecheck && electron-vite build && pnpm build:utility",
    "build:utility": "vite build --config vite.utility.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests *.ts",
    "test": "vitest run tests/unit",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@frade/adapter-yaml": "workspace:*",
    "@frade/repository-api": "workspace:*",
    "@frade/repository-application": "workspace:*",
    "@frade/repository-domain": "workspace:*",
    "@frade/repository-ports": "workspace:*",
    "@frade/local-index": "workspace:*",
    "@frade/draw": "workspace:*",
    "@frade/runtime-contracts": "workspace:*",
    "@frade/runtime-electron": "workspace:*",
    "@frade/runtime-node": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@frade/ui-workspace": "workspace:*"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-vite": "5.0.0",
    "vite": "6.1.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "@playwright/test": "1.57.0",
    "@types/node": "24.10.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7"
  }
}
