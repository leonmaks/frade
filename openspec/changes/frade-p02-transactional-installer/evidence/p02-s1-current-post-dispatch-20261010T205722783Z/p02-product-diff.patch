+      (m: any) => {
+        m.contributes.commands = []
+      },
+    ],
+    [
+      'browser script',
+      (m: any) => {
+        m.browser = 'main.js'
+      },
+    ],
+    [
+      'native script',
+      (m: any) => {
+        m.main = 'main.js'
+      },
+    ],
+    [
+      'capability',
+      (m: any) => {
+        m.capabilities = ['repository.read']
