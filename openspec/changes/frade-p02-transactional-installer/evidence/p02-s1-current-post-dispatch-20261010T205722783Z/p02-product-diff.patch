+    if (owner.length + proof.length > 16 * 1024) refuse('BOOTSTRAP_BUDGET_EXCEEDED')
+    const owned = await write('owner.json', owner, false); await read('owner.json', owner)
+    const ownerId = identity(await list([PROBE]), 'owner.json', 'file')
+    if (ownerId !== owned.identity) refuse('BOOTSTRAP_IDENTITY_UNCERTAIN')
+    const pending = await write('pending.tmp', proof, true)
