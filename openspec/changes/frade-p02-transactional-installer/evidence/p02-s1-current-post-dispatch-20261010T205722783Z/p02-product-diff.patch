+    ],
+    [
+      'duplicate theme',
+      (m: any) => {
+        m.contributes.themes.push(m.contributes.themes[0])
+      },
+    ],
+    [
+      'invalid semver',
+      (m: any) => {
+        m.version = '01.0.0'
+      },
+    ],
+    [
+      'invalid range',
+      (m: any) => {
+        m.engines.frade = 'nonsense'
