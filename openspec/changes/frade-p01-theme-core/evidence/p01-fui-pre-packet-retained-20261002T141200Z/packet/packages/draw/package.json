{
  "name": "@frade/draw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./document": "./src/document/serialize.ts",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:consumer": "tsc -p tests/consumer/tsconfig.json --noEmit --pretty false",
    "lint": "eslint src tests *.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bdd": "vitest run tests/unit/bdd-mapping.test.ts tests/unit/bdd-contract.test.ts",
    "test:visual": "playwright test",
    "test:visual:matrix": "playwright test tests/spike/floating-symmetry.spec.ts",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@antv/x6": "3.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@cucumber/gherkin": "35.1.0",
    "@cucumber/messages": "29.0.1",
    "@playwright/test": "1.57.0",
    "@types/node": "24.10.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "6.1.0",
    "vitest": "3.2.7"
  }
}
