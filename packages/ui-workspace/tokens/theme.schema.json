{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frade color theme v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "colors"
  ],
  "properties": {
    "kind": {
      "enum": [
        "light",
        "dark",
        "high-contrast"
      ]
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface.base": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface.panel": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface.rail": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface.hover": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface.overlay": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "text.primary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "text.secondary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "text.disabled": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "border.subtle": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "border.control": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "action.primary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "action.primaryHover": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "action.onPrimary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "selection.bg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "selection.fg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "selection.indicator": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "focus.ring": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "status.success": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "status.successBg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "status.warning": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "status.warningBg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "status.error": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "status.errorBg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "status.info": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "status.infoBg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "diagram.canvas": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "diagram.grid": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "diagram.nodeBg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "diagram.nodeStroke": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "diagram.edge": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "diagram.selection": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "syntax": {
      "type": "object"
    }
  }
}
